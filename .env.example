# Register a PUBLIC client at https://dev.twitch.tv/console/apps.
# The client ID is public metadata. Do not add a client secret.
TWITCH_CLIENT_ID=
PORT=3000
# Bind loopback only; share read-only overlay B through the protected room tunnel.
HOST=127.0.0.1
# Live tokens stay in ignored data/; demo needs no Twitch credentials.
# TWITCH_CLIENT_ID is the ID of a Public Twitch app; no client secret is needed.

# Optional extra ignored bot logins (comma-separated; built-in bots are always ignored).
IGNORED_CHATTERS=
